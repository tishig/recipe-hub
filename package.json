{
  "name": "recipe-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsx tools/validate.ts",
    "build": "tsx tools/build-sql.ts",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 migrations apply recipes --local",
    "db:init:remote": "wrangler d1 migrations apply recipes --remote",
    "db:load:local": "npm run build && wrangler d1 execute recipes --local --file=build/recipes.sql",
    "db:load:remote": "npm run build && wrangler d1 execute recipes --remote --file=build/recipes.sql --yes"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
